{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**/*.[sS][rR][tT]" },
        { "path": "**/*.[vV][tT][tT]" },
        { "path": "**/*.[aA][sS][sS]" },
        { "path": "**/*.[sS][sS][aA]" },
        { "path": "**/*.[lL][rR][cC]" },
        { "path": "**/*.[tT][xX][tT]" },
        { "path": "**/*.[mM][pP]4" },
        { "path": "**/*.[mM][kK][vV]" },
        { "path": "**/*.[wW][aA][vV]" },
        { "path": "**/*.[mM][pP]3" }
      ],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.config/**" }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.config/**" },
        { "path": "$HOME/Library/**" }
      ]
    }
  ]
}
