{
  "name": "finalsub",
  "private": true,
  "version": "1.0.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare:tauri-target": "node scripts/prepare-tauri-target.mjs",
    "prepare:release-updater-config": "node scripts/prepare-release-updater-config.mjs",
    "preflight:release": "node scripts/release-preflight.mjs",
    "test:release-preflight": "node --test scripts/release-preflight.test.mjs",
    "prepare:windows-signing-config": "node scripts/prepare-windows-signing-config.mjs",
    "test:windows-signing-config": "node --test scripts/windows-signing-config.test.mjs",
    "setup:mac:signing": "bash scripts/ensure-macos-signing-identity.sh",
    "pretauri": "npm run prepare:tauri-target",
    "tauri": "tauri",
    "pretauri:build": "npm run prepare:tauri-target",
    "tauri:build": "tauri build",
    "verify:bundle": "bash scripts/verify-finalsub-macos-app.sh \"$PWD/src-tauri/target/release/bundle/macos/FinalSub.app\"",
    "cleanup:bundle-apps:macos": "bash scripts/cleanup-finalsub-bundle-apps-macos.sh",
    "build:local:bundle": "npm run setup:mac:signing && npm run tauri:build && npm run verify:bundle",
    "build:local": "bash scripts/run-with-finalsub-bundle-cleanup-macos.sh build:local:bundle",
    "binaries:universal": "bash scripts/prepare-macos-universal-sidecars.sh",
    "pretauri:build:universal": "npm run prepare:tauri-target",
    "tauri:build:universal": "tauri build --target universal-apple-darwin",
    "verify:bundle:universal": "bash scripts/verify-finalsub-macos-app.sh \"$PWD/src-tauri/target/universal-apple-darwin/release/bundle/macos/FinalSub.app\"",
    "build:universal:bundle": "npm run binaries:universal && npm run tauri:build:universal && npm run verify:bundle:universal",
    "build:universal": "bash scripts/run-with-finalsub-bundle-cleanup-macos.sh build:universal:bundle",
    "package:release:self-signed:macos": "bash scripts/package-macos-self-signed-release.sh",
    "install:local:universal": "bash scripts/install-finalsub-local-macos.sh",
    "build:install:universal": "bash scripts/run-with-finalsub-bundle-cleanup-macos.sh build:universal:bundle install:local:universal",
    "build:validation:macos-intel": "npm run tauri -- build --target x86_64-apple-darwin --bundles app --config src-tauri/tauri.validation.conf.json && bash scripts/verify-macos-intel-app.sh \"$PWD/src-tauri/target/x86_64-apple-darwin/release/bundle/macos/FinalSub.app\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "vite": "^8.1.4"
  }
}
